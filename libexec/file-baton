#!/bin/sh
# file-baton launcher: runs the binary built for this platform.
# A development build in libexec/dev/ (make build) takes precedence.
# A missing binary never blocks Claude Code: hook calls exit 0.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
os=$(uname -s | tr '[:upper:]' '[:lower:]')
case $(uname -m) in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) arch=$(uname -m) ;;
esac
for exe in "$dir/dev/file-baton" "$dir/$os-$arch/file-baton"; do
  if [ -x "$exe" ]; then
    exec "$exe" "$@"
  fi
done
msg="file-baton is inactive: this install has no binary for $os-$arch. Update or reinstall the plugin: claude plugin update file-baton@file-baton"
if [ "$1" = hook ]; then
  if [ "$2" = session-start ]; then
    printf '{"systemMessage":"%s"}\n' "$msg"
  fi
  exit 0
fi
echo "$msg" >&2
exit 1
